root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
# Visual Studio's spell checker uses US English and the project word list that CI (scripts/spell_check.py) and Vale
# use, so a word the editor accepts passes CI and the other way round.
spelling_languages = en-us
spelling_exclusion_path = .vale/styles/config/vocabularies/RaidManager/accept.txt

[*.cs]
csharp_style_namespace_declarations = file_scoped:error
dotnet_diagnostic.CS1591.severity = error
dotnet_diagnostic.SA1124.severity = none
dotnet_diagnostic.SA1123.severity = error
dotnet_diagnostic.SA1600.severity = error
dotnet_diagnostic.SA1601.severity = error
dotnet_diagnostic.SA1602.severity = error
dotnet_diagnostic.SA1611.severity = error
dotnet_diagnostic.SA1615.severity = error
dotnet_diagnostic.SA1618.severity = error
dotnet_diagnostic.SA1623.severity = error

[*.{g.cs,Designer.cs,feature.cs}]
generated_code = true

# EF Core writes migrations and the model snapshot; they are regenerated, not edited by hand.
[**/Migrations/*.cs]
generated_code = true
