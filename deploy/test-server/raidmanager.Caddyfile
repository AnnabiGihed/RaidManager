# RaidManager test environment (ADR-0027)
# provision.sh appends these sites to the shared proxy's Caddyfile. Until RaidManager's containers join the `web`
# network, each site answers 503 with a short message, over HTTPS with its own certificate.

raidmanager-test.pivotsoftwares.com {
    encode gzip
    reverse_proxy raidmanager-web:8080
    handle_errors 502 503 504 {
        respond "RaidManager test environment: not deployed yet, or restarting." 503
    }
}

api.raidmanager-test.pivotsoftwares.com {
    encode gzip
    reverse_proxy raidmanager-api:8080
    handle_errors 502 503 504 {
        respond "RaidManager test API: not deployed yet, or restarting." 503
    }
}
