<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="pivot-framework" value="https://nuget.pkg.github.com/AnnabiGihed/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="pivot-framework">
      <package pattern="Pivot.Framework.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <pivot-framework>
      <add key="Username" value="%PIVOT_PACKAGES_USER%" />
      <add key="ClearTextPassword" value="%PIVOT_PACKAGES_TOKEN%" />
    </pivot-framework>
  </packageSourceCredentials>
</configuration>
