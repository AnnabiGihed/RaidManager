classDiagram
    Community "1" *-- "0..*" CommunityRole : has
    Community "1" *-- "0..*" DiscordRoleMapping : maps
    DiscordRoleMapping "0..*" --> "1" CommunityRole : gives
    Community "0..*" --> "1" User : administered by
    User "1" --> "0..*" CompanionPairing : authorizes
    User "1" --> "0..*" CharacterClaim : requests
    class Community {
        CommunityId Id
        string DiscordGuildId
        WarmaneRealm Realm
        UserId AdministratorId
    }
    class CommunityRole {
        CommunityRoleId Id
        string Name
        CommunityPermissions Permissions
    }
    class DiscordRoleMapping {
        string DiscordRoleId
        CommunityRoleId RoleId
    }
    class User {
        UserId Id
        DiscordUserId DiscordUserId
        string TimeZoneId
    }
    class CompanionPairing {
        PairingState State
    }
    class CharacterClaim {
        CharacterId CharacterId
        ClaimState State
    }
