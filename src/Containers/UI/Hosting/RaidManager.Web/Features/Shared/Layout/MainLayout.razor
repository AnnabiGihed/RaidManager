@inherits LayoutComponentBase

<RadzenComponents />
<AuthorizeView>
    <Authorized>
        <div class="rm-theme-dark">
            <RadzenLayout>
                <RadzenHeader>
                    <div class="shell-top-bar">
                        <Breadcrumb Items="@BreadcrumbItems" />
                        <div class="shell-session">
                            <UserAvatar Name="@context.User.Identity?.Name" ImageUrl="@AvatarUrl(context.User)" />
                            <SignOutButton />
                        </div>
                    </div>
                </RadzenHeader>
                <RadzenSidebar Responsive="false">
                    <div class="shell-sidebar">
                        <BrandLogo />
                        <a class="shell-community-link" href="@CommunityHref">
                            <SummaryTile Title="@Community.CardTitle" Subtitle="@Community.CardSubtitle" data-testid="community-card">
                                <Leading>
                                    <IconTile Glyph="@Community.CardGlyph" Appearance="@CommunityGlyphAppearance" />
                                </Leading>
                            </SummaryTile>
                        </a>
                        <nav class="shell-navigation" aria-label="Main">
                            @foreach (var group in NavigationGroups)
                            {
                                <NavigationSection @key="group.Heading" Heading="@group.Heading" Entries="@group.Entries" />
                            }
                        </nav>
                        <div class="shell-user">
                            <SummaryTile Title="@(context.User.Identity?.Name ?? string.Empty)" Subtitle="@Community.RoleLabel" Appearance="SummaryTileAppearance.Plain" data-testid="user-card">
                                <Leading>
                                    <UserAvatar Name="@context.User.Identity?.Name" ImageUrl="@AvatarUrl(context.User)" />
                                </Leading>
                            </SummaryTile>
                        </div>
                    </div>
                </RadzenSidebar>
                <RadzenBody>
                    <ErrorBoundary @ref="_errorBoundary">
                        <ChildContent>
                            @Body
                        </ChildContent>
                        <ErrorContent Context="error">
                            <RadzenStack Gap="1rem" class="rz-p-4">
                                <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1">Something went wrong</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1">This page could not be shown. Try again, or go back to the home page.</RadzenText>
                                <RadzenButton Text="Try again" Click="Recover" />
                            </RadzenStack>
                        </ErrorContent>
                    </ErrorBoundary>
                </RadzenBody>
            </RadzenLayout>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="public-frame rm-theme-dark rm-surface-page" data-testid="public-frame">
            <BrandLogo />
            <main class="public-column">
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="error">
                        <RadzenCard>
                            <RadzenStack Gap="1rem">
                                <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1">Something went wrong</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body1">This page could not be shown. Try again, or go back to the home page.</RadzenText>
                                <RadzenButton Text="Try again" Click="Recover" />
                            </RadzenStack>
                        </RadzenCard>
                    </ErrorContent>
                </ErrorBoundary>
            </main>
        </div>
    </NotAuthorized>
</AuthorizeView>
