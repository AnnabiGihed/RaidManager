@namespace RaidManager.Web.Features.Shared.Components
<div class="@CssClass" @attributes="AdditionalAttributes">
    @Leading
    <span class="summary-tile-text">
        <span class="summary-tile-title">@Title</span>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <span class="summary-tile-subtitle">@Subtitle</span>
        }
    </span>
    @if (ShowsLink)
    {
        <span class="summary-tile-chevron" aria-hidden="true">›</span>
    }
</div>
