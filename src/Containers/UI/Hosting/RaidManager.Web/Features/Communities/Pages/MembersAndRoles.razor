@page "/community/members"

<PageTitle>Members · Raid Manager</PageTitle>

<div class="community-page">
    <PageHeading Eyebrow="Community" Title="Members and roles" Subtitle="Roles follow Discord. The highest mapped role applies; everyone else in the server is a Member." />
    @switch (Members.Status)
    {
        case CommunityPageStatus.Ready:
            <div class="members-table-width">
                <DataTable Items="@Members.Rows" Headings="@Headings" Key="@(member => member.DiscordUserId)" data-testid="members-table">
                    <RowTemplate Context="member">
                        <td>
                            <span class="member-name">
                                <UserAvatar Name="@member.DisplayName" ImageUrl="@member.AvatarUrl" />
                                @member.DisplayName
                            </span>
                        </td>
                        <td class="member-discord-roles">@member.DiscordRoles</td>
                        <td><TagChip Text="@member.RoleLabel" Tone="@RoleTone(member.Role)" /></td>
                    </RowTemplate>
                </DataTable>
            </div>
            <TextNote Text="@Members.CheckedNote" />
            break;
        case CommunityPageStatus.Failed:
            <div class="community-column">
                <Notice Tone="NoticeTone.Danger" Title="@Members.Problem!.Title" Message="@Members.Problem.Message" data-testid="members-problem" />
                <div>
                    <ActionButton Text="Try again" Appearance="ActionButtonAppearance.Secondary" Click="LoadAsync" />
                </div>
            </div>
            break;
    }
</div>
