@page "/sign-in/failed"

<PageTitle>@ViewModel.Title</PageTitle>

<SurfaceCard Title="@ViewModel.Title" HeadingLevel="HeadingLevel.H1" Accent="@Accent" data-testid="sign-in-failed-card">
    <ChildContent>@ViewModel.Message</ChildContent>
    <Actions>
        <ActionButton Text="Try again" Click="TryAgain" />
        <ActionButton Text="Back to home" Appearance="ActionButtonAppearance.Secondary" Click="GoHome" />
    </Actions>
</SurfaceCard>
