@page "/"

<PageTitle>Raid Manager</PageTitle>

<RadzenStack Gap="1rem" class="rz-p-4">
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Warmane Raid Manager</RadzenText>
    <AuthorizeView>
        <Authorized>
            <RadzenText TextStyle="TextStyle.Body1">Welcome, @context.User.Identity?.Name. Your characters and raids will appear here.</RadzenText>
        </Authorized>
        <NotAuthorized>
            <RadzenText TextStyle="TextStyle.Body1">Sign in with Discord to plan raids with your characters.</RadzenText>
        </NotAuthorized>
    </AuthorizeView>
</RadzenStack>
