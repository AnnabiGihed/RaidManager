@page "/characters/review"

<PageTitle>Review your new characters</PageTitle>

<div class="review-page rm-design-page">
    <PageHeading Eyebrow="New characters" Title="Review your new characters" Subtitle="Your companion found these characters on your WoW accounts. Only the ones you approve can sign up for raids.">
        <Actions>
            @if (CanDecideLater)
            {
                <ActionButton Text="Decide later" Appearance="ActionButtonAppearance.Secondary" Click="Continue" data-testid="decide-later" />
            }
        </Actions>
    </PageHeading>

    @if (_notice is { } notice)
    {
        <Toast Title="@notice.Title" Message="@notice.Detail" Tone="@ToneOf(notice.Kind)" data-testid="review-notice" />
    }

    @if (ViewModel.Status == CharacterReviewStatus.Loading)
    {
        <TextNote Text="Loading your characters…" />
    }
    else if (ViewModel.Status == CharacterReviewStatus.Failed)
    {
        <div class="review-column">
            <Notice Tone="NoticeTone.Danger" Title="We couldn't load your characters" Message="Nothing was approved or rejected. Try again in a moment." data-testid="load-failed" />
            <div>
                <ActionButton Text="Try again" Click="LoadAsync" />
            </div>
        </div>
    }
    else if (ViewModel.PendingCount > 0)
    {
        <div class="review-claims">
            <Notice Title="@ViewModel.WaitingTitle" Message="Undecided characters stay pending, and this page opens again at your next sign-in." />
            <DataTable Items="@ViewModel.Claims" Headings="@Headings" Key="@(claim => claim.CharacterId)" ColumnWidths="@ColumnWidths" RowHeight="72" data-testid="claims">
                <RowTemplate Context="claim">
                    <td>
                        <span class="claim-name">@claim.Name</span>
                        <span class="claim-realm">@claim.Realm</span>
                    </td>
                    <td><WowClassLabel ClassName="@claim.Class" /></td>
                    <td>@claim.Race</td>
                    <td>@claim.Level</td>
                    <td class="claim-found">@ViewModel.FoundLabel(claim)</td>
                    <td><TagChip Text="@claim.ClaimState" Tone="@StatusTone(claim)" /></td>
                    <td>
                        @if (claim.IsPending)
                        {
                            <span class="claim-decision">
                                <ActionButton Text="Approve" Disabled="@IsDeciding" Click="@(() => ApproveAsync(claim))" data-testid="@($"approve-{claim.Name}")" />
                                <ActionButton Text="Reject" Appearance="ActionButtonAppearance.Secondary" Disabled="@IsDeciding" Click="@(() => AskToReject(claim))" data-testid="@($"reject-{claim.Name}")" />
                            </span>
                        }
                        else
                        {
                            <span class="claim-name">An officer will review it</span>
                            <span class="claim-realm">Another player owns it.</span>
                        }
                    </td>
                </RowTemplate>
            </DataTable>
        </div>
    }
    else
    {
        <EmptyState Title="You're all set" Message="No characters are waiting for your decision." data-testid="all-set">
            <ChildContent>
                @foreach (var conflict in ViewModel.Conflicts)
                {
                    <p @key="conflict.CharacterId" class="review-reminder">@CharacterReviewViewModel.ConflictReminder(conflict)</p>
                }
            </ChildContent>
            <Actions>
                <ActionButton Text="Continue" Click="Continue" />
            </Actions>
        </EmptyState>
    }

    @if (_rejecting is { } rejecting)
    {
        <ConfirmDialog Title="@CharacterReviewViewModel.RejectTitle(rejecting)" Message="@CharacterReviewViewModel.RejectMessage(rejecting)"
                       Detail="@CharacterReviewViewModel.RejectAdvice"
                       ConfirmText="Reject" ConfirmAppearance="ActionButtonAppearance.Danger" OnConfirm="RejectAsync" OnCancel="CancelReject"
                       data-testid="reject-dialog" />
    }
</div>
