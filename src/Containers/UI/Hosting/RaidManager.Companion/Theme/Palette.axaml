<!-- RaidManager's dark design system (ADR-0019) for the companion: the colors of raidmanager-theme.css under the same
     names in PascalCase, the Open Sans family and the type scale of the mockups. Views use only these resources. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="SurfacePageBrush" Color="#0B111C" />
  <SolidColorBrush x:Key="SurfaceTopBarBrush" Color="#111C2A" />
  <SolidColorBrush x:Key="SurfaceCardBrush" Color="#172333" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1C2B3E" />
  <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#1B4548" />
  <SolidColorBrush x:Key="LineDividerBrush" Color="#2B3B50" />
  <SolidColorBrush x:Key="LineCardBorderBrush" Color="#212F41" />
  <SolidColorBrush x:Key="BrandAccentBrush" Color="#5DE0C1" />
  <SolidColorBrush x:Key="BrandOnAccentBrush" Color="#102830" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EFF5FA" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9EADC1" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="#8394AA" />
  <SolidColorBrush x:Key="AccentAmberBrush" Color="#F3BE75" />
  <SolidColorBrush x:Key="StatusDangerBrush" Color="#F2878C" />
  <SolidColorBrush x:Key="StatusOnDangerBrush" Color="#2B1115" />
  <SolidColorBrush x:Key="StatusDangerBackgroundBrush" Color="#3F2329" />
  <SolidColorBrush x:Key="StatusDangerBorderBrush" Color="#6B3740" />
  <SolidColorBrush x:Key="StatusDangerTextBrush" Color="#F4A7AB" />
  <SolidColorBrush x:Key="StatusWarningBackgroundBrush" Color="#4B382A" />
  <SolidColorBrush x:Key="StatusWarningBorderBrush" Color="#5E4631" />
  <SolidColorBrush x:Key="StatusWarningTitleBrush" Color="#F9D7A7" />
  <SolidColorBrush x:Key="StatusWarningTextBrush" Color="#E2BA87" />
  <SolidColorBrush x:Key="StatusSuccessBackgroundBrush" Color="#173A36" />

  <FontFamily x:Key="BodyFont">avares://RaidManager.Companion/Assets/Fonts#Open Sans</FontFamily>
  <x:Double x:Key="FontSizeCode">32</x:Double>
  <x:Double x:Key="FontSizeMark">40</x:Double>
  <x:Double x:Key="FontSizeHeading">18</x:Double>
  <x:Double x:Key="FontSizeBody">14</x:Double>
  <x:Double x:Key="FontSizeLabel">13</x:Double>
  <x:Double x:Key="FontSizeCaption">12</x:Double>
  <x:Double x:Key="FontSizeEyebrow">11</x:Double>

  <CornerRadius x:Key="RadiusCard">12</CornerRadius>
  <CornerRadius x:Key="RadiusNotice">10</CornerRadius>
  <CornerRadius x:Key="RadiusControl">8</CornerRadius>
  <Thickness x:Key="WindowPadding">32,0</Thickness>
</ResourceDictionary>
