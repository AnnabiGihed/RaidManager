<!-- The boards of the companion sync mockup, 560 x 680 with the title bar: 1 (watched folders) and 9 (the folder added
     isn't a WoW installation), 2 (syncing), 3 (paused), 4 (offline), and 5 to 8 (a problem that needs the player),
     with the pairing footer under each. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sync="using:RaidManager.Companion.Client.Features.Sync"
             xmlns:shared="using:RaidManager.Companion.Features.Shared"
             xmlns:syncViews="using:RaidManager.Companion.Features.Sync"
             x:Class="RaidManager.Companion.Features.Sync.SyncView"
             x:DataType="sync:SyncViewModel">
  <Panel>
    <StackPanel x:Name="FoldersPanel" IsVisible="{Binding IsWatchedFolders}" Margin="32,32,32,0">
      <TextBlock Classes="heading" Text="Watched folders" />
      <TextBlock Classes="intro" Margin="0,10,0,0"
                 Text="RaidManager found these World of Warcraft folders. Clear&#10;an account to keep its characters out of RaidManager." />
      <TextBlock x:Name="SearchingText" Classes="status" Margin="0,6,0,0" IsVisible="{Binding IsSearching}"
                 Text="Searching your drives for World of Warcraft…" />
      <StackPanel Margin="0,5,0,0">
        <shared:Notice x:Name="NotWowNotice" Margin="0,0,0,16" IsVisible="{Binding IsFolderRejected}"
                       Title="This isn't a WoW folder" Message="Choose the folder that holds Wow.exe and the WTF folder." />
        <ItemsControl x:Name="InstallationList" ItemsSource="{Binding Installations}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="16" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sync:WatchedInstallationViewModel">
              <Border Classes="card" Padding="0,0,0,8">
                <StackPanel>
                  <TextBlock Classes="eyebrow" Margin="20,14,20,0" Text="INSTALLATION" />
                  <TextBlock Classes="path" Margin="20,4,20,0" Text="{Binding Folder}" />
                  <ItemsControl Margin="0,9,0,0" ItemsSource="{Binding Accounts}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="sync:WatchedAccountViewModel">
                        <StackPanel>
                          <Border Classes="divider" />
                          <Grid Height="43" ColumnDefinitions="*,Auto">
                            <CheckBox Theme="{StaticResource AccountCheckBox}" Margin="20,0,0,0"
                                      Content="{Binding Name}" IsChecked="{Binding IsWatched}"
                                      AutomationProperties.Name="{Binding Name}" />
                            <TextBlock Grid.Column="1" Classes="note" Margin="0,0,20,0" VerticalAlignment="Center"
                                       Text="{Binding CountText}" />
                          </Grid>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,24,0,0">
        <Button x:Name="SaveButton" Classes="primary" Width="168" Content="Save and sync" Command="{Binding SaveCommand}" />
        <Button x:Name="FindAgainButton" Classes="secondary" Width="168" Content="Find folders again"
                Command="{Binding FindFoldersAgainCommand}" />
        <Button x:Name="AddFolderButton" Classes="secondary" Width="144" Content="Add a folder"
                Command="{Binding AddFolderCommand}" />
      </StackPanel>
    </StackPanel>

    <StackPanel x:Name="SyncingPanel" IsVisible="{Binding IsSyncing}" Margin="32,32,32,0">
      <Grid>
        <TextBlock Classes="heading" Text="Sync" />
        <shared:Badge Classes="success" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Text="Syncing" />
      </Grid>
      <TextBlock Classes="intro" Margin="0,10,0,0" Text="Snapshots upload when WoW finishes writing them." />
      <syncViews:SyncStatsCard Margin="0,8,0,0" />
      <Border Classes="card" Margin="0,16,0,0" Padding="0,0,0,8">
        <StackPanel>
          <TextBlock Classes="title" Margin="20,18,20,0" Text="Recent activity" />
          <ItemsControl x:Name="ActivityList" Margin="0,18,0,0" ItemsSource="{Binding Activity}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sync:ActivityRowViewModel">
                <StackPanel>
                  <Border Classes="divider" />
                  <Grid Height="51" ColumnDefinitions="220,*">
                    <StackPanel Margin="20,6,0,0" Spacing="1">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                      <TextBlock Classes="note" Text="{Binding Realm}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,7,0,0" Spacing="6" IsVisible="{Binding IsUploading}">
                      <TextBlock Classes="status" FontWeight="SemiBold" Foreground="{StaticResource BrandAccentBrush}"
                                 Text="Uploading" />
                      <ProgressBar Classes="upload" Width="240" HorizontalAlignment="Left" IsIndeterminate="True"
                                   AutomationProperties.Name="Upload in progress" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,18,0,0" VerticalAlignment="Top"
                                IsVisible="{Binding IsWaitingForWow}">
                      <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource AccentAmberBrush}" />
                      <TextBlock Classes="status" Text="Waiting for WoW to finish writing" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="status" Margin="0,18,0,0" Foreground="{StaticResource TextMutedBrush}"
                               IsVisible="{Binding IsUploaded}" Text="{Binding UploadedText}" />
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,24,0,0">
        <Button x:Name="PauseButton" Classes="secondary" Width="140" Content="Pause sync" Command="{Binding PauseCommand}" />
        <Button x:Name="FoldersButton" Classes="secondary" Width="160" Content="Watched folders"
                Command="{Binding ShowFoldersCommand}" />
      </StackPanel>
    </StackPanel>

    <StackPanel x:Name="PausedPanel" IsVisible="{Binding IsPaused}" Margin="32,32,32,0">
      <Grid>
        <TextBlock Classes="heading" Text="Sync" />
        <shared:Badge HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Text="Paused" />
      </Grid>
      <TextBlock Classes="intro" Margin="0,10,0,0" Text="Nothing uploads until you resume." />
      <shared:Notice Classes="info" Margin="0,8,0,0" Title="Sync is paused"
                     Message="New snapshots wait here and upload when you resume." />
      <syncViews:SyncStatsCard Margin="0,16,0,0" />
      <Button x:Name="ResumeButton" Classes="primary" Width="160" HorizontalAlignment="Left" Margin="0,24,0,0"
              Content="Resume sync" Command="{Binding ResumeCommand}" />
    </StackPanel>

    <StackPanel x:Name="OfflinePanel" IsVisible="{Binding IsOffline}" Margin="32,32,32,0">
      <Grid>
        <TextBlock Classes="heading" Text="Sync" />
        <shared:Badge Classes="danger" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Text="Offline" />
      </Grid>
      <TextBlock Classes="intro" Margin="0,10,0,0" Text="Uploads wait in the queue; nothing is lost." />
      <shared:Notice Classes="danger" Margin="0,8,0,0" Title="Can't reach RaidManager"
                     Message="You're offline, or the service is down. It retries on its own." />
      <syncViews:SyncStatsCard Margin="0,16,0,0" />
      <Button x:Name="RetryNowButton" Classes="primary" Width="140" HorizontalAlignment="Left" Margin="0,24,0,0"
              Content="Retry now" Command="{Binding RetryNowCommand}" />
    </StackPanel>

    <StackPanel x:Name="ProblemPanel" IsVisible="{Binding IsNeedingAttention}" Margin="32,32,32,0">
      <Grid>
        <TextBlock Classes="heading" Text="Sync" />
        <shared:Badge Classes="warning" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0"
                      Text="Needs attention" />
      </Grid>
      <TextBlock x:Name="ProblemHeadingLine" Classes="intro" Margin="0,10,0,0" Text="{Binding Problem.HeadingLine}" />
      <shared:Notice x:Name="ProblemNotice" Margin="0,8,0,0" Title="{Binding Problem.Title}"
                     Message="{Binding Problem.Message}" />
      <TextBlock x:Name="ProblemSteps" Classes="intro" Margin="0,20,0,0" Text="{Binding Problem.Steps}" />
      <Button x:Name="RetryButton" Classes="primary" Width="160" HorizontalAlignment="Left" Margin="0,20,0,0"
              Content="{Binding Problem.RetryLabel}" Command="{Binding RetryCommand}" />
    </StackPanel>

    <StackPanel VerticalAlignment="Bottom" Height="44">
      <Border Classes="divider" />
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="32,0,0,0" Height="43">
        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource BrandAccentBrush}" />
        <TextBlock x:Name="PairedText" Classes="status" FontSize="{StaticResource FontSizeCaption}"
                   VerticalAlignment="Center" Text="{Binding PairedText}" />
      </StackPanel>
    </StackPanel>
  </Panel>
</UserControl>
