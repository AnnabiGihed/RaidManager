<!-- The companion's only window. It follows each board, title bar included: 480 x 600 for the pairing states and
     560 x 680 for the sync screens (owner decision on #551); the application's data templates pick the view. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:RaidManager.Companion.Client.Features.Shell"
        x:Class="RaidManager.Companion.Features.Shell.MainWindow"
        x:DataType="shell:ShellViewModel"
        Title="RaidManager Companion"
        Icon="/Assets/raidmanager.ico"
        Width="{Binding WindowWidth}"
        Height="{Binding WindowHeight}"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
  <ContentControl x:Name="Screen" Content="{Binding Current}" />
</Window>
