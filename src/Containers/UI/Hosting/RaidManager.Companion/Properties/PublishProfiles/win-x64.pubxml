<?xml version="1.0" encoding="utf-8"?>
<!-- One self-contained executable for Windows x64 (ADR-0032). Choose the environment with -p:CompanionEnvironment=Dev,
     Test or Production; without it the executable uses the local Development addresses. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <PublishDir>bin/publish/win-x64/</PublishDir>
  </PropertyGroup>
</Project>
