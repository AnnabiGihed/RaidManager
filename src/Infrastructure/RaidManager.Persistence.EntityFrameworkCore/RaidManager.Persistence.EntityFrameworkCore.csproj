<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>RaidManager.Persistence.EntityFrameworkCore</PackageId>
    <Version>1.0.0</Version>
    <PackageTags>persistence;entity-framework-core;sql-server;raid-management</PackageTags>
    <Description>Entity Framework Core persistence implementation for RaidManager.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Core/RaidManager.Application/RaidManager.Application.csproj" />
    <ProjectReference Include="../../Core/RaidManager.Domain/RaidManager.Domain.csproj" />
    <PackageReference Include="Pivot.Framework.Infrastructure.Persistence.EntityFrameworkCore" />
    <PackageReference Include="Pivot.Framework.Infrastructure.Messaging.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
